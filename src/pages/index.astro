            <h3 class="text-2xl font-display text-ivory mb-2">Coratina</h3>
            <p class="text-sm text-ivory/70">An ode to Apulian excellence</p>
          </div>
          
          <div class="flex gap-4 items-center">
            <div class="w-2 h-2 rounded-full bg-olive-muted/40"></div>
            <div class="w-2 h-2 rounded-full bg-bronze/40"></div>
            <div class="w-2 h-2 rounded-full bg-gold-accent/40"></div>
          </div>
        </div>
        
        <div class="mt-12 pt-8 border-t border-ivory/10 text-center text-sm text-ivory/60">
          <p>© 2026 Coratina. Celebrating the heritage of Corato and Apulia.</p>
        </div>
      </div>
    </footer>

  </main>
</Layout>

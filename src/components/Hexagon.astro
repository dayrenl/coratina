---
interface Props {
  size?: 'small' | 'medium' | 'large';
  className?: string;
}

const { size = 'medium', className = '' } = Astro.props;

const sizeClasses = {
  small: 'w-16 h-16',
  medium: 'w-24 h-24',
  large: 'w-32 h-32'
};
---

<div class={`clip-hexagon ${sizeClasses[size]} ${className}`}>
  <slot />
</div>

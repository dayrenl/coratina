---
interface Article {
  title: string;
  excerpt: string;
  image: string;
  category: string;
}

interface Props {
  articles: Article[];
}

const { articles } = Astro.props;
---

<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 md:gap-12">
  {
    articles.map((article, index) => (
      <article
        class="group cursor-pointer transition-smooth hover:-translate-y-2 animate-fadeInUp"
        style={`animation-delay: ${index * 100}ms`}
      >
        <div class="relative overflow-hidden mb-6 aspect-[3/4]">
          <img
            src={article.image}
            alt={article.title}
            class="w-full h-full object-cover transition-smooth group-hover:scale-110"
          />
          <div class="absolute inset-0 bg-gradient-to-b from-transparent to-charcoal/60 opacity-0 group-hover:opacity-100 transition-smooth" />
        </div>

        <div class="space-y-3">
          <span class="text-xs font-accent uppercase tracking-widest text-olive-golden">
            {article.category}
          </span>
          <h3 class="text-2xl md:text-3xl font-heading text-charcoal group-hover:text-olive-deep transition-smooth">
            {article.title}
          </h3>
          <p class="text-charcoal/70 leading-relaxed">{article.excerpt}</p>
        </div>
      </article>
    ))
  }
</div>
